{
  "name": "audiorap",
  "account_id": "9213ae688946caea617ba6fd5e4fbc5c",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "audiorap.com",
      "custom_domain": true
    },
    {
      "pattern": "www.audiorap.com",
      "custom_domain": true
    }
  ]
}
